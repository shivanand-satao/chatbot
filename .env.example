# Complete planned runtime configuration. NO real secrets belong in this file.
# Copy into Render's "Add from .env" and replace every REPLACE_ value privately.
# Runtime entry point is render_app:create_app(); local tools read ignored .env.
# Never commit your populated copy or upload the privileged local indexing .env.

# Backend gateway: frontend -> backend -> chatbot -> database.
BACKEND_ORIGIN=https://backend-crime-records-of-india.onrender.com
# Generate a strong random secret. Configure the SAME secret on the backend.
# Service authentication must be implemented before exposing application routes.
CHATBOT_SERVICE_SECRET=REPLACE_WITH_RANDOM_SERVICE_SECRET

# Separate least-privilege connections. Keep exact lowercase names.
# Use NEW passwords: credentials visible in the screenshot must be rotated.
# Supply the FULL connection strings privately; sslmode=require is required.
# History connection: existing chatbot_history_runtime role.
history_db_url=REPLACE_WITH_ROTATED_RESTRICTED_HISTORY_CONNECTION_STRING
# Retrieval connection: a separate read-only role, NOT postgres/indexing credentials.
# That read-only role/access has not yet been provisioned.
retrieval_db_url=REPLACE_WITH_RESTRICTED_READ_ONLY_RETRIEVAL_CONNECTION_STRING
analytics_db_url=REPLACE_WITH_RESTRICTED_ANALYTICS_CONNECTION_STRING

# Optional future generation/review. Never place this key in the frontend.
groq_api=REPLACE_WITH_GROQ_API_KEY

# Keep disabled until the corresponding implementation and checks are complete.
# Change flags only after deployment authentication and database probes pass.
HISTORY_ENABLED=false
RETRIEVAL_ENABLED=false
GENERATION_ENABLED=false
ANALYTICS_ENABLED=false
GROQ_MODEL=openai/gpt-oss-120b

# CPU only. No GPU. Model cache provisioning is a separate deployment step.
CUDA_VISIBLE_DEVICES=""
TOKENIZERS_PARALLELISM=false

# Do NOT add your application's JWT signing secret or user login credentials.
# Backend forwards authenticated requests; browser does not call chatbot directly.
# Do NOT add db_url here: legacy local tools use that privileged indexing DSN.
# Do NOT override PORT here: the deployment server must use its assigned port.
# Do NOT run migration/provisioning/indexing scripts as deployment start commands.